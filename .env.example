# Copy to .env. Everything works without keys except the ships layer.

# Ships — free key from https://aisstream.io
AISSTREAM_API_KEY=

# Trains — free key from https://labs.rejseplanen.dk (non-commercial, 50k calls/month)
REJSEPLANEN_API_KEY=

# Lightning — free key from https://dmiapi.govcloud.dk (lightningdata API)
DMI_LIGHTNING_KEY=

# Traffic flow tiles — free key from https://developer.tomtom.com (2,500 tiles/day)
TOMTOM_API_KEY=

# Webcams in Denmark via Windy — free key (non-commercial) from https://api.windy.com/keys
WINDY_API_KEY=

# Server
PORT=4200
# Who may open the API-key panel: comma-separated CIDRs. Loopback is always allowed.
# Example for a LAN: SETTINGS_ALLOW=30.11.0.0/20
SETTINGS_ALLOW=
HOST=0.0.0.0

# Poll intervals (seconds)
FLIGHTS_POLL=15
ODIN_POLL=90
TRAFFIC_POLL=180
TRAINS_POLL=60
AUTOBAHN_POLL=300
ENERGY_POLL=120
